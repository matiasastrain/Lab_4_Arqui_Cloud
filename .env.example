# Variables para docker compose. Copiar a .env y ajustar (.env no se versiona).
# Todas tienen un valor por defecto en docker-compose.yml, así que .env es opcional.

# --- Seguridad (solo para desarrollo local; en GCP vienen de Secret Manager) ---
FUNCIONARIO_API_KEY=clave-local
JWT_SECRET=desarrollo-local-solo-para-pruebas-32-bytes

# --- PostgreSQL 15 ---
POSTGRES_USER=pdi_app
POSTGRES_PASSWORD=pdi_local
POSTGRES_DB=pdi

# --- Puertos publicados en el host ---
API_PORT=8090
PORTAL_PORT=8091
NOTIFICACIONES_PORT=8092
ADAPTADORES_PORT=8093
POSTGRES_PORT=5433
